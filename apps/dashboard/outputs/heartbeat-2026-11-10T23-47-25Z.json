{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Heartbeat"
      },
      "children": [
        "heading",
        "sep1",
        "alert",
        "sep2",
        "fleet",
        "statsRow",
        "sep3",
        "statusRow"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "⚠️ Heartbeat: 1 stalled PR",
        "level": "h2"
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "🟡 STALLED",
        "message": "PR #251 `aeon-update: sync 4 upstream commits (4d64089..5981e1c)` open since 2026-11-09 20:53 UTC (~27h, no activity since).",
        "type": "warning"
      },
      "children": []
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "fleet": {
      "type": "Text",
      "props": {
        "text": "Fleet otherwise clean: all 9 enabled skills last_status=success, 0 consecutive failures, nothing stuck.",
        "variant": "body"
      },
      "children": []
    },
    "statsRow": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat_skills",
        "stat_failures"
      ]
    },
    "stat_skills": {
      "type": "Stat",
      "props": {
        "label": "Enabled skills",
        "value": "9"
      },
      "children": []
    },
    "stat_failures": {
      "type": "Stat",
      "props": {
        "label": "Consecutive failures",
        "value": "0"
      },
      "children": []
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "statusRow": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "statusLabel",
        "statusBadge",
        "statusNote"
      ]
    },
    "statusLabel": {
      "type": "Text",
      "props": {
        "text": "Status page:",
        "variant": "muted"
      },
      "children": []
    },
    "statusBadge": {
      "type": "Badge",
      "props": {
        "text": "🟡 WATCH",
        "variant": "secondary"
      },
      "children": []
    },
    "statusNote": {
      "type": "Text",
      "props": {
        "text": "(only this PR)",
        "variant": "caption"
      },
      "children": []
    }
